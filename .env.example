# Bloom configuration. Copy to .env for local use; NEVER commit a real .env with
# secrets. Every key here is also documented in the README. Precedence is
# flags > environment > these defaults. All keys carry the BLOOM_ prefix.

# --- HTTP server ---
# Listen address.
BLOOM_HTTP_ADDR=:8080
# Bound reading request headers (server hardening).
BLOOM_HTTP_READ_HEADER_TIMEOUT=5s
# Bound reading the full request including body.
BLOOM_HTTP_READ_TIMEOUT=15s
# Bound writing the response. Do not set for streaming endpoints.
BLOOM_HTTP_WRITE_TIMEOUT=15s
# Bound idle keep-alive connection lifetime.
BLOOM_HTTP_IDLE_TIMEOUT=60s
# Max non-streaming request body size in bytes (1 MiB).
BLOOM_HTTP_MAX_BODY_BYTES=1048576

# --- Database (database/sql pool; ADR 0004) ---
# Engine: sqlite (default, pure-Go modernc.org/sqlite) or postgres (pgx).
BLOOM_DB_DRIVER=sqlite
# DSN. When BLOOM_DB_DRIVER=sqlite and this is empty, the default below is used:
# a WAL-mode file in the working directory with a 5s busy timeout. When
# BLOOM_DB_DRIVER=postgres the DSN is required, e.g.
#   postgres://user:pass@localhost:5432/bloom?sslmode=disable
BLOOM_DB_DSN=file:bloom.db?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)
# Cap total open connections (DB capacity / number of instances). SQLite is a
# single-writer engine; readers still benefit from a small pool under WAL.
BLOOM_DB_MAX_OPEN_CONNS=25
# Idle floor; must be <= BLOOM_DB_MAX_OPEN_CONNS.
BLOOM_DB_MAX_IDLE_CONNS=25
# Bound connection age (required behind a load balancer / proxy / failover).
BLOOM_DB_CONN_MAX_LIFETIME=30m
# Reap idle connections so the pool shrinks under low load.
BLOOM_DB_CONN_MAX_IDLE_TIME=5m
# Apply the embedded goose migrations on startup. Off by default: production
# applies migrations by running the binary with the -migrate flag (one-shot:
# migrate against the configured database, then exit). Startup self-migrate is
# a single-writer (dev, or one SQLite container) convenience.
BLOOM_DB_MIGRATE_ON_STARTUP=false

# --- Secrets (ADR 0006) ---
# Operator-supplied key that derives the at-rest encryption key for stored
# credentials (media-server API keys, OIDC client secrets, ...). REQUIRED; at
# least 32 bytes. It is never logged and never returned by the API. Generate one:
#   openssl rand -base64 48
BLOOM_SECRET_KEY=

# One-time input for `bloom create-admin --username <name>`. Leave empty to use
# the hidden terminal prompt. Never pass a password as a command-line flag.
BLOOM_BOOTSTRAP_PASSWORD=

# --- Authentication and browser sessions (ADR 0006) ---
# Secure, HttpOnly, SameSite=Lax cookie named bloom_session. Disable Secure only
# for plaintext local development; production must leave it true.
BLOOM_SESSION_COOKIE_SECURE=true
# Absolute and inactivity expiry for server-side sessions.
BLOOM_SESSION_LIFETIME=24h
BLOOM_SESSION_IDLE_TIMEOUT=30m
# Login token buckets apply independently to the direct client IP and username.
# Each bucket starts with 5 attempts and regains one attempt per minute.
BLOOM_LOGIN_RATE_REFILL_INTERVAL=1m
BLOOM_LOGIN_RATE_BURST=5
# Combined in-memory bound for tracked IP and username keys (2-100000).
BLOOM_LOGIN_RATE_MAX_KEYS=10000
# Global memory-safety bound for concurrent Argon2id verification (1-64).
# Attempts above the limit receive 503 immediately and are not queued.
BLOOM_LOGIN_MAX_CONCURRENT=4
# Comma-separated reverse-proxy CIDRs allowed to supply X-Forwarded-For.
# Empty (the secure default) uses the direct peer address and ignores the header.
BLOOM_TRUSTED_PROXY_CIDRS=

# --- Telemetry ---
# Log level: debug | info | warn | error.
BLOOM_LOG_LEVEL=info
# Log format: json (production) | text (local).
BLOOM_LOG_FORMAT=json
# OTLP/HTTP trace collector endpoint as host:port (NO scheme), e.g.
# otel-collector:4318. Empty disables span export: the service installs a
# never-sampling tracer provider and runs fully offline.
BLOOM_OTLP_ENDPOINT=
# Send spans over plaintext HTTP instead of TLS. Only for in-cluster collectors
# or local development.
BLOOM_OTLP_INSECURE=false
# Head-based trace sampling ratio in [0,1]. 1.0 samples every trace; 0.0 none.
# Ignored when BLOOM_OTLP_ENDPOINT is empty. The Prometheus scrape endpoint at
# GET /metrics needs no configuration; it is always exposed.
BLOOM_TRACE_SAMPLE_RATIO=1.0

# --- Audit logging ---
# Security-relevant actions (ADR 0006 item 8: login success and failure, logout,
# API key create and revoke, role change, invite lifecycle) are emitted as
# structured audit events to a DEDICATED logger on its own stream (stderr,
# separate from the app log on stdout), per the handbook's operations/security.md.
# There is no env knob; a deployment routes stderr to the audit sink.

# --- Lifecycle ---
# Graceful shutdown budget. Must exceed worst-case in-flight work and stay under
# the platform termination grace (e.g. Kubernetes terminationGracePeriodSeconds).
BLOOM_SHUTDOWN_GRACE=15s
